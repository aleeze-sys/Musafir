@page
@model musafir.Areas.Identity.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    ViewData["Title"] = "Log in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log in | Musafir</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="auth-page">
    <nav class="navbar site-nav">
        <div class="container">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">M</span> musafir<span class="brand-period">.</span>
            </a>
            <a class="back-home" asp-area="" asp-controller="Home" asp-action="Index">← Back to home</a>
        </div>
    </nav>

    <div class="auth-main">
        <div class="auth-image login-image">
            <div class="auth-image-overlay"></div>
            <div class="auth-image-copy">
                <div class="eyebrow text-white">
                    <span class="eyebrow-line"></span> THE JOURNEY STARTS HERE
                </div>
                <h1>Every trip has a <em>beginning.</em></h1>
                <p>Pick up where you left off and keep your travel plans together.</p>
                <span class="image-credit-line">MUSAFIR · EXPLORE PAKISTAN</span>
            </div>
        </div>

        <div class="auth-form-side">
            <div class="auth-form-wrap">
                <span class="section-kicker">WELCOME BACK</span>
                <h2>Good to see you <em>again.</em></h2>
                <p class="auth-subtitle">Log in to access your Musafir account.</p>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email address</label>
                        <input asp-for="Input.Email" class="form-control auth-input" autocomplete="username" aria-required="true" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" class="form-control auth-input" autocomplete="current-password" aria-required="true" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <button id="login-submit" type="submit" class="btn btn-dark-green w-100">Log in ↗</button>
                </form>

                <p class="auth-switch">
                    New to Musafir? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
                </p>
            </div>
        </div>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
